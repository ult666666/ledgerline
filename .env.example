# Copy to .env for local development. Every value here is a placeholder.

# SQLite file in the working directory (default). For PostgreSQL install the
# "postgres" extra and use e.g.
#   DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@localhost:5432/ledgerline
DATABASE_URL=sqlite:///./ledgerline.db

# Comma-separated bearer tokens accepted by the API. This placeholder is for
# local use only; generate real keys with `uv run ledgerline generate-key`.
LEDGERLINE_API_KEYS=dev-key-change-me

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LEDGERLINE_LOG_LEVEL=INFO
